# Same Supabase project the website uses (see hng-15-stage-1 .env.local).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public URL of the deployed website (used for product images and the checkout / booking hand-off).
# Use an https URL for the APK build; Android release builds block plain http.
EXPO_PUBLIC_SITE_URL=https://your-site.vercel.app
